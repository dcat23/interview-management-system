
# Postgres
DATABASE_NAME=ims
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=default
DATABASE_PASSWORD=password

# Kafka
BOOTSTRAP_SERVERS=localhost:9092
# Aiven: set BOOTSTRAP_SERVERS to the service URI, add aiven to SPRING_PROFILES_ACTIVE
# and put service.cert, service.key and ca.pem in infra/kafka/aiven/
KAFKA_REPLICAS=3

# Auth
JWT_SECRET=
FRONTEND_ORIGIN=http://localhost:4200

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# Tunnels
CLOUDFLARED_TOKEN=
NGROK_AUTHTOKEN=